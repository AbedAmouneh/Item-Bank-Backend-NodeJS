{
  "name": "item-bank",
  "version": "0.5.10",
  "description": "Production-grade backend API template (Node.js, TypeScript, Fastify, PostgreSQL)",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/runmodes/api/index.js",
    "start:jobs": "node dist/runmodes/jobs/index.js",
    "dev": "nodemon runmodes/api/index.ts",
    "dev:jobs": "nodemon runmodes/jobs/index.ts",
    "build": "bash tests/setup/scripts/build.sh",
    "migrate": "ts-node tests/setup/scripts/migrate.ts",
    "fixtures:load": "ts-node tests/setup/scripts/load-fixtures.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:api": "vitest run tests/api --passWithNoTests",
    "test:jobs": "vitest run tests/jobs --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "npx tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,js,json}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,js,json}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "seed:games": "ts-node scripts/seed_game_questions.ts"
  },
  "keywords": [
    "backend",
    "nodejs",
    "typescript",
    "fastify",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@sinclair/typebox": "^0.34.48",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.69.2",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "fast-csv": "^5.0.5",
    "fastify": "^5.7.4",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.9.0",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.18.0",
    "nodemon": "^3.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.2.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
